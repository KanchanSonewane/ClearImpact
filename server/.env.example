# CLEARIMPACT SERVER CONFIGURATION
PORT=5000
NODE_ENV=development

# Database Configuration
# Leave MONGODB_URI empty to automatically use the embedded in-memory MongoDB instance
# or provide an external MongoDB connection string:
# MONGODB_URI=mongodb://localhost:27017/clearimpact

# Authentication Secret
JWT_SECRET=clearimpact_super_secure_jwt_secret_key_demo_2026

# Razorpay Test / Sandbox Credentials
# Safe sandbox mock values; NEVER use real live production credentials
RAZORPAY_KEY_ID=rzp_test_clearimpact_sandbox
RAZORPAY_KEY_SECRET=clearimpact_sandbox_secret_key_demo

# AI LLM API Integration (Optional - System automatically uses deterministic grounded AI fallback if omitted)
# GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
